{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-nutrition.example/contracts/raw.subscription_events/v1.json",
  "title": "raw.subscription_events v1 (producer payload)",
  "description": "Append-only landing table for clickstream, subscription lifecycle, billing and messaging events. Micro-batch landing every 15 minutes (ADR-003).",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Producer-generated UUID; idempotency key for merges (ADR-003)."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "page_view",
        "product_view",
        "add_to_cart",
        "checkout_completed",
        "subscription_created",
        "subscription_paused",
        "subscription_skipped",
        "subscription_resumed",
        "subscription_cancelled",
        "cancel_page_view",
        "payment_succeeded",
        "payment_failed",
        "email_sent",
        "email_opened",
        "email_clicked",
        "sms_sent",
        "sms_clicked",
        "unsubscribed"
      ],
      "description": "Event name from the controlled vocabulary."
    },
    "source": {
      "type": "string",
      "enum": [
        "web",
        "app",
        "billing",
        "subscription_platform",
        "esp",
        "sms"
      ],
      "description": "Producing system."
    },
    "event_time": {
      "type": "string",
      "format": "date-time",
      "description": "When the event happened (UTC), set by the producer."
    },
    "subscriber_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Surrogate subscriber key; null for anonymous web/app traffic."
    },
    "anonymous_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Cookie/device identifier (hashed in staging)."
    },
    "ip_address": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Client IP; dropped in staging (R-06 end action)."
    },
    "user_agent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Client user agent."
    },
    "properties": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "description": "Event-specific payload; free text is DLP-scanned before landing (ABAC-07)."
    }
  },
  "required": [
    "event_id",
    "event_type",
    "source",
    "event_time"
  ],
  "additionalProperties": false
}
